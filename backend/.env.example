# Copy to .env (git-ignored) and fill in. Never commit real values.

# HMAC key for signing access tokens: at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Groq API key for the assistant (chat model). Needed from the assistant issues on; see ADR 0007.
GROQ_API_KEY=

# Gemini API key for the assistant's embeddings (ADR 0015), from aistudio.google.com > Get API key.
GEMINI_API_KEY=

# Card payments, Stripe TEST mode only (ADR 0013). From dashboard.stripe.com > Developers > API keys,
# with "Test mode" on. The webhook secret is printed by: stripe listen --forward-to localhost:8080/api/webhooks/card
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Which websites may call the API from a browser, comma separated. Leave out locally.
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# M-Pesa sandbox (ADR 0019), from developer.safaricom.co.ke > My Apps. The passkey for shortcode 174379
# is on Daraja's "Lipa na M-Pesa Online" test page. Locally the callback base is a tunnel address
# (for example from ngrok); the secret is any long random text: openssl rand -hex 24
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
