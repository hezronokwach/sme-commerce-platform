  "components" : {
    "schemas" : {
      "UpdateProductRequest" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int32"
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 0
          },
          "priceMinor" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 0
          },
          "imageUrl" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "ACTIVE", "ARCHIVED" ]
          }
        },
        "required" : [ "name", "priceMinor", "status", "version" ]
      },
      "ProductResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "categoryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "priceMinor" : {
            "type" : "integer",
            "format" : "int64"
          },
          "currency" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "SaveCategoryRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "slug" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "sortOrder" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 10000,
            "minimum" : 0
          }
        },
        "required" : [ "name" ]
      },
      "CategoryResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "sortOrder" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "LineRequest" : {
        "type" : "object",
        "properties" : {
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 99,
            "minimum" : 1
          }
        },
        "required" : [ "productId", "quantity" ]
      },
      "PlaceOrderRequest" : {
        "type" : "object",
        "properties" : {
          "customerName" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "customerPhone" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0
          },
          "paymentMethod" : {
            "type" : "string",
            "enum" : [ "MPESA", "CARD", "FAKE" ]
          },
          "lines" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LineRequest"
            },
            "maxItems" : 50,
            "minItems" : 0
          }
        },
        "required" : [ "customerName", "customerPhone", "lines", "paymentMethod" ]
      },
      "PlaceOrderResponse" : {
